# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
.venv/
.venv*/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# IDE artifacts (should never be committed)
.project
.pydevproject

# Local environment files
.env
.env.local
.env.*.local

# Translations
*.mo
*.pot

# Django stuff:
*.log
app/startup.log

# Sphinx documentation
docs/_build/

# Local backups generated by scripts/backup_state.py
backups/

# Runtime shelve database files (generated during app use)
playerdb
playerdb.bak
playerdb.dat
playerdb.dir
recentplayers
recentplayers.bak
recentplayers.dat
recentplayers.dir
app/match_history
app/match_history.bak
app/match_history.dat
app/match_history.dir

# PyBuilder
target/
